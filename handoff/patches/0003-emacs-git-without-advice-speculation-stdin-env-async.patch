+        (cl-letf (((symbol-function 'scrutiny-agent-fs--delegate)
+                   (lambda (operation _args) (setq delegated operation) nil)))
+          (start-file-process "git" nil "git" "rev-parse" "HEAD"))
+        (should (eq delegated 'start-file-process))))))
